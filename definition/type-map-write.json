[
  { "match": "exact", "canonical": "Boolean", "native": "Nullable(Bool)" },

  { "match": "exact", "canonical": "Int8",   "native": "Nullable(Int8)" },
  { "match": "exact", "canonical": "Int16",  "native": "Nullable(Int16)" },
  { "match": "exact", "canonical": "Int32",  "native": "Nullable(Int32)" },
  { "match": "exact", "canonical": "Int64",  "native": "Nullable(Int64)" },
  { "match": "exact", "canonical": "UInt8",  "native": "Nullable(UInt8)" },
  { "match": "exact", "canonical": "UInt16", "native": "Nullable(UInt16)" },
  { "match": "exact", "canonical": "UInt32", "native": "Nullable(UInt32)" },
  { "match": "exact", "canonical": "UInt64", "native": "Nullable(UInt64)" },

  { "match": "exact", "canonical": "Float16", "native": "Nullable(Float32)" },
  { "match": "exact", "canonical": "Float32", "native": "Nullable(Float32)" },
  { "match": "exact", "canonical": "Float64", "native": "Nullable(Float64)" },

  { "match": "regex", "canonical": "^Decimal(?:128|256)\\((?<precision>\\d+),\\s*(?<scale>\\d+)\\)$", "native": "Nullable(Decimal(${precision}, ${scale}))" },

  { "match": "exact", "canonical": "Utf8",      "native": "Nullable(String)" },
  { "match": "exact", "canonical": "LargeUtf8", "native": "Nullable(String)" },
  { "match": "exact", "canonical": "Null",      "native": "Nullable(String)" },

  { "match": "exact", "canonical": "Binary",      "native": "Nullable(String)" },
  { "match": "exact", "canonical": "LargeBinary", "native": "Nullable(String)" },
  { "match": "regex", "canonical": "^FixedSizeBinary\\((?<width>\\d+)\\)$", "native": "Nullable(FixedString(${width}))" },

  { "match": "exact", "canonical": "Date32", "native": "Nullable(Date32)" },
  { "match": "exact", "canonical": "Date64", "native": "Nullable(Date32)" },

  { "match": "regex", "canonical": "^Timestamp\\(SECOND(?:,\\s*[^)]+)?\\)$",      "native": "Nullable(DateTime64(0, 'UTC'))" },
  { "match": "regex", "canonical": "^Timestamp\\(MILLISECOND(?:,\\s*[^)]+)?\\)$", "native": "Nullable(DateTime64(3, 'UTC'))" },
  { "match": "regex", "canonical": "^Timestamp\\(MICROSECOND(?:,\\s*[^)]+)?\\)$", "native": "Nullable(DateTime64(6, 'UTC'))" },
  { "match": "regex", "canonical": "^Timestamp\\(NANOSECOND(?:,\\s*[^)]+)?\\)$",  "native": "Nullable(DateTime64(9, 'UTC'))" },

  { "match": "regex", "canonical": "^Time32\\((?:SECOND|MILLISECOND)\\)$",          "native": "Nullable(Int32)" },
  { "match": "regex", "canonical": "^Time64\\((?:MICROSECOND|NANOSECOND)\\)$",      "native": "Nullable(Int64)" },
  { "match": "regex", "canonical": "^Duration\\((?:SECOND|MILLISECOND|MICROSECOND|NANOSECOND)\\)$", "native": "Nullable(Int64)" },

  { "match": "exact", "canonical": "Json",   "native": "Nullable(String)" },
  { "match": "exact", "canonical": "Object", "native": "Nullable(String)" },
  { "match": "exact", "canonical": "List",   "native": "Nullable(String)" }
]
